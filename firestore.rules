rules_version = '2';

// Sécurité Firestore — projet Batchcooking Emma.
// Principe : vitrine en LECTURE PUBLIQUE, ÉCRITURE réservée à Emma (admin unique).
// Aucune écriture publique (pas de commande, pas de paiement, pas de formulaire en
// base pour l'instant — cf. cahier des charges, la collection `demandes` est en V2).
service cloud.firestore {
  match /databases/{database}/documents {

    // UID(s) autorisé(s) à écrire. Liste = on peut avoir un compte par
    // environnement (staging / prod) avec le même fichier de règles.
    function isEmma() {
      return request.auth != null
        && request.auth.uid in [
          'QiUKEqPZ3AVliVZ9FATcjsP6ysq2' // staging — n.chateau.pro@gmail.com
          // , 'UID_EMMA_PROD'            // prod — compte de tatie Emma (à ajouter)
        ];
    }

    match /config_generale/{docId} {
      allow read: if true;
      allow write: if isEmma();
    }

    match /plats/{platId} {
      allow read: if true;
      allow write: if isEmma();
    }

    match /formules/{formuleId} {
      allow read: if true;
      allow write: if isEmma();
    }

    match /pages/{pageId} {
      allow read: if true;
      allow write: if isEmma();
    }

    // Tout le reste est refusé par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
