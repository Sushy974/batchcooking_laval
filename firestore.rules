rules_version = '2';

// Sécurité Firestore — projet Batchcooking Emma.
// Principe : vitrine en LECTURE PUBLIQUE, ÉCRITURE réservée à Emma (admin unique).
// Aucune écriture publique (pas de commande, pas de paiement, pas de formulaire en
// base pour l'instant — cf. cahier des charges, la collection `demandes` est en V2).
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ Remplacer par l'UID réel du compte Firebase d'Emma.
    function isEmma() {
      return request.auth != null
        && request.auth.uid == 'REMPLACER_PAR_UID_EMMA';
    }

    match /config_generale/{docId} {
      allow read: if true;
      allow write: if isEmma();
    }

    match /plats/{platId} {
      allow read: if true;
      allow write: if isEmma();
    }

    match /formules/{formuleId} {
      allow read: if true;
      allow write: if isEmma();
    }

    match /pages/{pageId} {
      allow read: if true;
      allow write: if isEmma();
    }

    // Tout le reste est refusé par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
